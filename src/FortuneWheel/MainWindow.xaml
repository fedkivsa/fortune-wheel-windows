<Window x:Class="FortuneWheel.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FortuneWheel"
 Title="Fortune Wheel" Width="1380" Height="940" MinWidth="1050" MinHeight="720"
 Background="#0C131F" Foreground="#E9EFF8" FontFamily="Segoe UI" FontSize="14"
 UseLayoutRounding="True" Closing="Window_Closing">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="StartButton" Content="▶  Start round" Background="#3478EA" BorderBrush="#3478EA" FontWeight="SemiBold" Padding="24,10" Click="StartRound"/>
    <Button x:Name="StopButton" Content="Cancel round" IsEnabled="False" Click="CancelRound"/>
   </StackPanel>
   <StackPanel><TextBlock Text="Fortune Wheel" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock Text="Equal player sectors · Any spin can land on any field" Foreground="#93A4BB" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="450"/><ColumnDefinition Width="22"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <StackPanel x:Name="Editor">
     <Border Style="{StaticResource Card}">
      <Expander Header="Field editor" IsExpanded="True" Foreground="#E9EFF8" FontSize="18">
      <StackPanel Margin="0,10,0,0" TextElement.FontSize="14">
       <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Content="+ Player" Click="AddPlayer"/>
        <TextBlock Text="Players" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="Enter relative weights. For example, 1 and 3 give 25% and 75%." Foreground="#93A4BB" FontSize="12" TextWrapping="Wrap" Margin="3,0,0,10"/>
       <ItemsControl ItemsSource="{Binding Players}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border BorderBrush="#344256" BorderThickness="0,0,0,1" Padding="0,4,0,12" Margin="0,0,0,10">
          <StackPanel>
           <DockPanel>
            <Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding}" Click="RemovePlayer" FontSize="12"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" AutomationProperties.Name="Player name"/>
           </DockPanel>
           <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate><DataTemplate>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="20"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Field name"/>
              <TextBox Grid.Column="1" Text="{Binding Share, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Field weight"/>
              <TextBlock Grid.Column="2" Text=""/>
              <Button Grid.Column="3" Content="×" Tag="{Binding}" Click="RemoveField" Padding="6" ToolTip="Remove field" AutomationProperties.Name="Remove field"/>
             </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
           <StackPanel Orientation="Horizontal">
            <Button Content="+ Field" Tag="{Binding}" Click="AddField" FontSize="12"/>
            <Button Content="Equal weights" Tag="{Binding}" Click="EqualShares" FontSize="12"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      </Expander>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Spin settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
        <TextBlock Text="Default force" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding DefaultForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Default force -10 to 10"/>
        <TextBlock Grid.Column="2" Text="Default drag" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBox Grid.Column="3" Text="{Binding DefaultDrag, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Default drag 1 to 10"/>
       </Grid>
       <TextBlock Text="Force: -10 to 10. Drag: 1 to 10. Blank = default." Foreground="#93A4BB" FontSize="12" Margin="0,8"/>
       <Grid Margin="3,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Text="Player"/><TextBlock Grid.Column="1" Text="Force"/><TextBlock Grid.Column="2" Text="Drag"/>
       </Grid>
       <ItemsControl ItemsSource="{Binding Players}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBox Grid.Column="1" Text="{Binding Force, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, TargetNullValue=''}" ToolTip="Positive force: clockwise. Negative: counterclockwise. Zero: no spin. Blank inherits default." AutomationProperties.Name="Player force override"/>
          <TextBox Grid.Column="2" Text="{Binding Drag, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, TargetNullValue=''}" ToolTip="Braking strength, 1 to 10. Blank inherits default." AutomationProperties.Name="Player drag override"/>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock Text="Force: + clockwise / − counterclockwise; 0 means no spin." TextWrapping="Wrap" Foreground="#93A4BB" FontSize="12" Margin="0,8"/>
       <CheckBox Content="Vary spin impulse (±10%)" IsChecked="{Binding VaryImpulse}" ToolTip="Apply a random multiplier from 0.9 to 1.1 to initial speed. The physics still determines the result."/>
       <StackPanel Orientation="Horizontal"><Button Content="Load .ini" Click="LoadIni"/><Button Content="Save .ini" Click="SaveIni"/></StackPanel>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Viewbox Stretch="Uniform">
     <Grid Width="680" Height="680">
      <local:WheelView x:Name="Wheel" Width="620" Height="620"/>
      <!-- Only this small pointer rotates, around the shared wheel center. -->
      <Path Data="M 328,14 L 352,14 L 340,43 Z" Fill="#F8FAFC" Stroke="#0C131F" StrokeThickness="3" IsHitTestVisible="False">
       <Path.RenderTransform><RotateTransform x:Name="PointerRotation" CenterX="340" CenterY="340"/></Path.RenderTransform>
      </Path>
     </Grid>
    </Viewbox>
    <StackPanel Grid.Row="1" Margin="8,0,8,16">
     <TextBlock x:Name="RoundStatus" Text="Ready to spin" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="OrderText" Text="Each player spins once. Two seconds between spins." Foreground="#93A4BB" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
     <StackPanel><TextBlock Text="Round results" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ItemsControl x:Name="ResultsList"><ItemsControl.ItemTemplate><DataTemplate>
       <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="Feedback" Foreground="#F9C66D" TextWrapping="Wrap" Margin="0,14,0,0"/>
 </Grid>
</Window>
